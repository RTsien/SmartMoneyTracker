# SmartMoneyTracker 环境变量配置示例
# 复制此文件为 .env 并填入您的实际配置

# Tushare API Token
# 注册地址: https://tushare.pro/register
TUSHARE_TOKEN=your_tushare_token_here

# A股历史行情：默认使用腾讯接口，可切换为 eastmoney
AKSHARE_HISTORY_SOURCE=tencent

# AkQuant 技术指标后端：rust / python / auto
QUANT_ENGINE=akquant
AKQUANT_TALIB_BACKEND=rust

# 外部数据请求超时（秒）
DATA_REQUEST_TIMEOUT=15

# 持久化缓存（服务重启后仍可复用，默认有效期 1 天）
PERSISTENT_CACHE_ENABLED=true

# 批量扫描并发与分市场请求间隔（秒）
BATCH_MAX_WORKERS=3
BATCH_RATE_LIMIT_A_STOCK=0.35
BATCH_RATE_LIMIT_US_STOCK=0.50
BATCH_RATE_LIMIT_HK_STOCK=0.50

# 收盘后监控（Asia/Shanghai）与告警
MONITOR_A_STOCK_TIME=15:30
MONITOR_HK_STOCK_TIME=16:30
MONITOR_US_STOCK_TIME=06:30
MONITOR_ANALYZE_STRUCTURE=false
# 披露接口较慢，默认由 snapshot_disclosures.py 独立采集
ALERT_RATINGS=STRONG_BUY,STRONG_SELL
ALERT_LOG_PATH=./reports/alerts.jsonl
# ALERT_WEBHOOK_URL=https://your-webhook.example/path

# 时点披露数据库（历史回测只读取公告时点之前的数据）
DISCLOSURE_DB_PATH=./data/disclosures.sqlite3
DISCLOSURE_TIMEZONE=Asia/Shanghai
DISCLOSURE_CAPTURE_TIMEOUT=45
